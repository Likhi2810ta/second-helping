# Same values as the frontend's VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Only needed if your project still signs tokens with the legacy
# HS256 secret (Dashboard -> Project Settings -> JWT Keys). Projects on the new
# asymmetric signing keys are verified through the public JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Never put the service_role key here. The API talks to Supabase with the
# logged-in user's own token, so Row Level Security still decides access.
